@dag(
    dag_id="exemplo_post_requests",
    start_date=datetime(2026, 1, 1),
    schedule=None,
    catchup=False,
)
def pipeline_api():

    @task
    def enviar_dados_post():
        url = "http://api.olhovivo.sptrans.com.br/v2.1/Posicao/Linha?codigoLinha={codigoLinha}"
        headers = {
            "Content-Type": "application/json",
            "Authorization": "Bearer 1274680751ad10c6dd7991ac8b7e3d2a51380c8414bc576b9dfc692b848287c8"
        }
        payload = {
            "usuario": "airflow_bot",
            "acao": "processar_lote",
            "valor": 1500
        }

        response = requests.post(url, json=payload, headers=headers, timeout=30)
        
        # Garante que a task falhe se o status for 4xx ou 5xx
        response.raise_for_status()
        
        # O retorno é salvo automaticamente no XCom
        return response.json()

    @task
    def processar_resposta(resultado):
        print(f"Status do recurso: {resultado.get('status')}")

    dados = enviar_dados_post()
    processar_resposta(dados)

pipeline_api()

    